{
  "name": "02 - Buscar (RAG)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-search",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "226c1168-8bd0-41b1-8bda-4fc8b3018d2c",
      "name": "Webhook búsqueda",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "webhookId": "ff729ffe-1fdf-4da8-bcd9-0abaf933282d",
      "notes": "POST /webhook/rag-search. Cabecera X-RAG-API-Key. Cuerpo: { query, limit?, source_type? }."
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "79fb92b3-5358-4bff-8fd1-252d491faa25",
              "name": "outline_url",
              "value": "https://docs.example.com",
              "type": "string"
            },
            {
              "id": "a0f7086c-d153-4875-b44e-815b3c517d0d",
              "name": "embeddings_url",
              "value": "http://embeddings:80/embed",
              "type": "string"
            },
            {
              "id": "fad6e322-cb66-428e-a4d7-fce98fab0057",
              "name": "embedding_model",
              "value": "intfloat/multilingual-e5-small",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1be326ea-0c54-4006-a46c-4bb8d5405ac7",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ],
      "notes": "Constantes del entorno. Edita aquí tu dominio de Outline, la URL del servidor de embeddings y el modelo."
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  const query = String(body.query ?? '').trim();\n  if (!query) { out.push({ json: { valid: false, error: 'query is required' } }); continue; }\n  const requestedLimit = Number(body.limit ?? 5);\n  const limit = Number.isFinite(requestedLimit)\n    ? Math.min(Math.max(Math.trunc(requestedLimit), 1), 20)\n    : 5;\n  const source_type = String(body.source_type ?? 'all').trim().toLowerCase() || 'all';\n  if (!['outline', 'repo', 'all'].includes(source_type)) {\n    out.push({ json: { valid: false, error: 'source_type must be one of: outline, repo, all' } });\n    continue;\n  }\n  out.push({ json: { valid: true, query, limit, source_type } });\n}\nreturn out;"
      },
      "id": "f42abc1f-df02-4cc6-8da3-24e02aff5976",
      "name": "Validar petición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "notes": "Comprueba que la petición trae una query y normaliza limit y source_type."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "76ca2719-9685-445c-a606-32db67f1de89",
      "name": "¿Petición válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.embeddings_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "inputs",
              "value": "={{ 'query: ' + $('Validar petición').item.json.query }}"
            }
          ]
        }
      },
      "id": "52f7d251-4f98-46c4-8830-35bf93eaed34",
      "name": "Embeddings de consulta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        220
      ],
      "notes": "El prefijo 'query: ' es obligatorio en los modelos E5.",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const requests = $('Validar petición').all();\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const raw = items[i].json;\n  let vector = raw;\n  if (Array.isArray(raw) && Array.isArray(raw[0])) vector = raw[0];\n  if (raw && Array.isArray(raw.embedding)) vector = raw.embedding;\n  if (!Array.isArray(vector) || vector.length !== 384) {\n    throw new Error('Embedding dimension mismatch: expected 384, received ' +\n      (Array.isArray(vector) ? vector.length : typeof vector));\n  }\n  const request = (requests[i] && requests[i].json) ? requests[i].json : items[i].json;\n  out.push({ json: { ...request, query_embedding: vector } });\n}\nreturn out;"
      },
      "id": "7de9b5ab-c55f-42f9-bdd3-2f0bc1bc10e6",
      "name": "Normalizar embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        220
      ],
      "notes": "Valida las 384 dimensiones del vector de la consulta.",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id AS document_id, d.source_type, d.title, d.canonical_url, d.collection,\n  c.chunk_index, c.content,\n  ROUND((1 - (c.embedding <=> $1::vector))::numeric, 6) AS score\nFROM knowledge_chunks c\nJOIN knowledge_documents d ON d.id = c.document_id\nWHERE ($2::text = 'all' OR d.source_type = $2::text)\nORDER BY c.embedding <=> $1::vector\nLIMIT LEAST(GREATEST($3::int, 1), 20)",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ ['[' + $json.query_embedding.join(',') + ']', $json.source_type, $json.limit] }}"
        }
      },
      "id": "d7ceb9b4-244c-4f75-85a0-2fcecc6a9b9f",
      "name": "Búsqueda semántica",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Ordena por distancia coseno (<=>) y devuelve los fragmentos más parecidos."
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {
          "responseCode": 200
        }
      },
      "id": "108028db-273e-4f50-b6a9-68ecf336b134",
      "name": "Responder resultados",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1800,
        220
      ],
      "notes": "Devuelve los fragmentos con su documento de origen."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ error: 'invalid_request' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "8e81a040-0dc1-46eb-90a6-02d2df1ed549",
      "name": "Responder no válida",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1120,
        420
      ],
      "notes": "400 si la petición es inválida."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ error: 'search_unavailable' }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "9317c0a0-70b0-4703-89e7-e3c3913a0599",
      "name": "Responder error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1800,
        430
      ],
      "notes": "502 si falla el embedding o la base de datos."
    },
    {
      "parameters": {
        "content": "### API de búsqueda semántica\n\nPOST /webhook/rag-search\nCabecera: X-RAG-API-Key\nCuerpo: { query, limit?, source_type? }\n\nEmbebe la pregunta y busca los fragmentos más cercanos en pgvector. `source_type` puede ser outline, repo o all.",
        "height": 170,
